SCOREBOARD_V2_ENV=development
SCOREBOARD_V2_HOST=0.0.0.0
SCOREBOARD_V2_PORT=8100

ULTISCORES_URL=https://ultiscores.com/4x/ext/watchlive.php/
ULTISCORES_PROD_URL=https://scores.frisbee.pl/ext/watchlive.php/
ULTISCORES_TEST_URL=https://scores.frisbee.pl/test3/ext/watchlive.php/
ULTISCORES_TIMEOUT_SECONDS=8

POLL_BASE_INTERVAL_SECONDS=1.0
POLL_MIN_INTERVAL_SECONDS=1
POLL_MAX_INTERVAL_SECONDS=5.0
POLL_SCHEDULE_INTERVAL_SECONDS=30.0
POLL_HEALTHY_STREAK_FOR_RECOVERY=4
POLL_CIRCUIT_BREAKER_ERROR_THRESHOLD=5
POLL_CIRCUIT_BREAKER_COOLDOWN_SECONDS=20.0

WEBSOCKET_HEARTBEAT_TIMEOUT_SECONDS=20
MATCH_ACTIVE_WINDOW_BEFORE_MINUTES=10
MATCH_ACTIVE_WINDOW_AFTER_MINUTES=110

# OBS views background color (6-digit hex, with or without #). Default: magenta for chroma key.
# OBS_BG_COLOR=FF00FF
OBS_BG_COLOR=FFFFFF